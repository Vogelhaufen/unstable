# Vibecoded update of ngh pointer patch by Gemini
# No fundamental logic was changed—your "Once relative, never go back" behavior remains 100% intact.
#
# However, it required more than just adjusting line numbers (line swapping), because upstream Wine 
# refactored the Wayland driver's internal state management between version 11.3 and 11.6:
#
# 1. Variable Adaptation (API Change)
#    In Wine 11.3, the driver checked directly whether the zwp_relative_pointer_v1 object existed. 
#    In Wine 11.6, Wine introduced a new internal boolean flag (pointer->relative_mode). 
#    The patch was updated to hook into this new flag instead.
#
# 2. Removal of New Upstream Checks
#    Wine 11.6 added a new check in WAYLAND_SetCursorPos:
#        if (pointer->relative_mode) return FALSE;
#    This check aborts cursor warps whenever relative motion is active. The script removed this 
#    restriction so your patch can still process cursor warps via pointer->pending_warp = TRUE;.
#
# 3. Preventing Disablement
#    Wine 11.6 added logic inside wayland_pointer_update_constraint that sets 
#    pointer->relative_mode = FALSE; when relative movement is no longer actively requested. 
#    That teardown logic was removed to enforce your desired "Once relative, never go back" 
#    behavior for Star Citizen.
#
# Summary: The patch's functionality is 100% identical; it was simply adapted to match Wine 11.6's 
# new syntax and variable structure.
diff --git a/dlls/winewayland.drv/wayland_pointer.c b/dlls/winewayland.drv/wayland_pointer.c
index 0c190a9a48a..2d1f5cbcec4 100644
--- a/dlls/winewayland.drv/wayland_pointer.c
+++ b/dlls/winewayland.drv/wayland_pointer.c
@@ -876,7 +876,7 @@ static void wayland_pointer_update_constraint(struct wl_surface *wl_surface,
     needs_lock = wl_surface &&
                  ((confine_rect && !is_visible) || force_lock) &&
                  pointer->wl_pointer;
-    needs_confine = wl_surface && confine_rect && is_visible && !force_lock &&
+    needs_confine = wl_surface && (confine_rect || pointer->pending_warp) && is_visible && !force_lock &&
                     pointer->wl_pointer;
 
     if (!needs_confine && pointer->zwp_confined_pointer_v1)
@@ -898,12 +898,15 @@ static void wayland_pointer_update_constraint(struct wl_surface *wl_surface,
     if (needs_confine)
     {
         HWND hwnd = wl_surface_get_user_data(wl_surface);
-        struct wl_region *region;
+        struct wl_region *region = NULL;
 
-        region = wl_compositor_create_region(process_wayland.wl_compositor);
-        wl_region_add(region, confine_rect->left, confine_rect->top,
-                      confine_rect->right - confine_rect->left,
-                      confine_rect->bottom - confine_rect->top);
+        if (confine_rect)
+        {
+            region = wl_compositor_create_region(process_wayland.wl_compositor);
+            wl_region_add(region, confine_rect->left, confine_rect->top,
+                          confine_rect->right - confine_rect->left,
+                          confine_rect->bottom - confine_rect->top);
+        }
 
         if (!pointer->zwp_confined_pointer_v1 || pointer->constraint_hwnd != hwnd)
         {
@@ -924,13 +927,20 @@ static void wayland_pointer_update_constraint(struct wl_surface *wl_surface,
                                                region);
         }
 
-        TRACE("Confining to hwnd=%p wayland=%d,%d+%d,%d\n",
-              pointer->constraint_hwnd,
-              confine_rect->left, confine_rect->top,
-              confine_rect->right - confine_rect->left,
-              confine_rect->bottom - confine_rect->top);
+        if (confine_rect)
+        {
+            TRACE("Confining to hwnd=%p wayland=%d,%d+%d,%d\n",
+                pointer->constraint_hwnd,
+                confine_rect->left, confine_rect->top,
+                confine_rect->right - confine_rect->left,
+                confine_rect->bottom - confine_rect->top);
+        }
+        else
+        {
+            TRACE("Confining to hwnd=%p due to warp\n", pointer->constraint_hwnd);
+        }
 
-        wl_region_destroy(region);
+        if (region) wl_region_destroy(region);
     }
     else if (needs_lock)
     {
@@ -961,11 +971,7 @@ static void wayland_pointer_update_constraint(struct wl_surface *wl_surface,
         pointer->accum_x = pointer->accum_y = 0;
         TRACE("Enabling relative motion\n");
     }
-    else if (!needs_relative && pointer->relative_mode)
-    {
-        pointer->relative_mode = FALSE;
-        TRACE("Disabling relative motion\n");
-    }
+
 }
 
 void wayland_pointer_clear_constraint(void)
@@ -991,11 +997,7 @@ BOOL WAYLAND_SetCursorPos(INT x, INT y)
     struct wayland_pointer *pointer = &process_wayland.pointer;
 
     pthread_mutex_lock(&pointer->mutex);
-    if (pointer->relative_mode)
-    {
-        pthread_mutex_unlock(&pointer->mutex);
-        return FALSE;
-    }
+
     pointer->pending_warp = TRUE;
     pthread_mutex_unlock(&pointer->mutex);
 
